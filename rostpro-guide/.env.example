# SMTP — те же значения, что настроены для planr-site, чтобы заявки
# с гайда и с сайта приходили на один и тот же адрес.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Куда падают заявки. Если не задано — используется office@rostpro.com.
CONTACT_EMAIL_TO=
